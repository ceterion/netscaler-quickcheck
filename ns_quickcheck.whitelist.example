# Ablage: /var/nssnapshot/ns_quickcheck.whitelist, Besitzer root, Rechte 600.
# Eine Regel pro Zeile: <typ>:<regex>   (Regex im ERE-Dialekt, Groß-/Kleinschreibung relevant)
# Zeilen mit # sind Kommentare. Jede Regel braucht eine Begruendung im Kommentar darueber.
#
# Typen:
#   user:      lokaler System-User, der nicht als Gelb gemeldet wird
#   listener:  Zeile aus sockstat -4l (Prozess, User, Adresse), die nicht als Rot gemeldet wird
#   path:      Dateipfad in Web-/Temp-Verzeichnissen, der nicht gemeldet wird
#   cron:      root-Crontab-Zeile, die nicht gemeldet wird
#   webfile:   Web-Datei, deren Aenderung seit Boot nicht gemeldet wird
#   mitigation: Muster (Regex), das an MITIGATION_RULE_RE angehaengt wird: Namen oder Ausdruecke der
#              eigenen Responder-/Traffic-Policies, damit sie als Mitigation erkannt werden
#
# Beispiele (auskommentiert):
# Zweites dienstliches Lesekonto (der Service-User aus CLI_USER braucht keinen Eintrag)
#user:^monitoring-ro$
# Eigene Mitigation-Policies: Namen der Policy Expressions oder Ausdrucksteile, Change CHG0012340
#mitigation:px_lp_|px_cmd|adfs/ls
# Custom-Monitoring des Betreibers, Perl-Listener auf 41500, Change CHG0012345
#listener:^perl .* \*:41500$
# Theme-Anpassung des Betreibers, wird vom Portal-Team gepflegt
#webfile:^/var/netscaler/logon/themes/BETREIBER/
