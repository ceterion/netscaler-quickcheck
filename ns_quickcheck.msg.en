PIN_HEAD	# Pin lines for ns_quickcheck.whitelist (%1 under %2), created %3 by ns_quickcheck %4. Diff against the previous version first, then take over the lines
PIN_SCOPE_ALL	all files
PIN_SCOPE_CODE	code only
