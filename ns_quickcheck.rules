# --- Gefixte Builds je Release-Train (Fallback fuer Script-V2 und wenn CVE_TABLE leer ist): "<Slot A> <Slot B>"
# A = CTX697096 (CVE-2026-88771..88778), B = CTX697174 (CVE-2026-88779, nur bei SAML relevant)
# +2026-09-27 CTX697096: Slot A 14.1-73.37, 13.1-64.23, 13.1-FIPS 37.279
# +2026-10-03 CTX697174: Slot B 14.1-73.41, 13.1-64.28, 13.1-FIPS 37.282
# +2026-10-09 CTX697191: Slot B (SAML) 14.1-73.46, 13.1-64.29, 13.1-FIPS 37.283, 14.1-FIPS 73.46 (Fallback kennt keine Rollen)
FIX_14_1="73.37 73.46"
FIX_13_1="64.23 64.29"
FIX_13_1_FIPS="37.279 37.283"      # 13.1-FIPS / NDcPP Train (Build 37.x)
FIX_14_1_FIPS="73.37 73.46"
# Releases ohne Fix
# +2026-09-27 CTX697096: 12.1 und 13.0 End-of-Life, kein Fix
EOL_RELEASES="12.1 13.0"
# Hinweis-Builds: bekannt problematisch
# +2026-10-05 Community-Beobachtung: 13.1-64.23 Early-Access, Cyclic Reboot mit NS Variables
BUILD_WARN_13_1="64.23:Early-Access-Build, Cyclic-Reboot mit NS Variables; 64.24 ist der GA-Build"

# --- Angriffsmuster CVE-2026-88771 (Log-Poisoning ueber Benutzername / User-Agent)
# Trigger-Text, den ns_monuploadd_err.pl sucht (Klartext und URL-encoded)
# +2026-09-28 watchTowr: "unexpectedly died", "missed too many heartbeats", "NSPPE-n ;" als Trigger des Monitor-Scripts
TRIGGER_RE='unexpectedly([[:space:]]|\+|%20)+died|missed([[:space:]]|\+|%20)+too([[:space:]]|\+|%20)+many([[:space:]]|\+|%20)+heartbeats|NSPPE(-[0-9]+)?([[:space:]]|%20)*(;|%3B)'
# Obfuskation / Shell-Metazeichen
# +2026-09-29 Mandiant/GTIG: ${IFS}-Obfuskation und Backtick-Subshells in beobachteten Payloads
# +2026-10-14 CISA SIGMA 29.09. (S9, S10): Extraktionsfragment des Droppers grep INDEX: / sed s/.*INDEX://
OBFUSC_RE='\$\{IFS\}|%24%7BIFS%7D|\$IFS|%60|`|\$\(|%24%28|\|sh([[:space:]]|$)|%7Csh|INDEX:'
# Kommandonamen, die in Payloads auftauchen (Wortgrenze davor wird im Script ergaenzt)
# +2026-09-29 Mandiant/GTIG, +2026-10-07 CISA 261399 r1: fetch/curl/wget-Downloader, perl/python-Listener, mkfifo-Reverse-Shells (generische Techniken)
# +2026-10-14 CISA SIGMA 29.09. (S8): b64decode -r, FreeBSD-Werkzeug im Dropper
CMD_NAMES='grep|sed|sh|bash|curl|wget|fetch|sleep|nc|perl|python|chmod|base64|openssl|mkfifo|b64decode'
# Zeilen in ns.log, die zum Logon gehoeren (Vorfilter, schnell)
# +2026-10-06 ceterion: Vorfilter, keine Angriffslogik
LOGON_HINT_RE='AAA LOGIN REQ|AAAD API|authenticate user|login|logon|User-Agent|nitro'
# Admin-Konfigbefehle enthalten Angriffsmuster per Design (eigene Policies): ausschliessen
# +2026-10-05 Community-Beobachtung (false-positive-Fix fuer CMD_EXECUTED)
# +2026-10-08 Lab 14.1-73.41: sh_command= (Shell-Audit nach local6, enthaelt eigene nscli-Aufrufe) und
#   nsprofmon_mgmt.pl (schreibt komplette ps-Ausgabe mit sed/Pipe ins Log) sind Systemquellen, keine Logons
ADMIN_CMD_RE='shell_command=|sh_command=|nsprofmon_mgmt\.pl|CMD_EXECUTED.* - Command "(add|bind|set|unset|rm|unbind|show|save|enable|disable|apply|batch|stat|sync|clear|update|create|restore|import|export|switch|link|unlink) '

# --- SAML-Angriff CVE-2026-88779: Crash-Zeilen des Authentifizierungsdaemons
# +2026-10-03 CTX697174 und Community-Berichte 04.10.: nsaaad-Neustarts und Pitboss-Meldungen bei SAML-Angriff
NSAAAD_CRASH_RE='\(nsaaad\).*exited on signal|proc nsaaad.*(SIGNALED|EXITED)|monitored processes have exited|maximum number of restarts|nsaaad unexpectedly died|Pitboss declaring system failure'
# --- DTLS CVE-2026-88772
# +2026-09-29 Mandiant/GTIG: DTLSv1.0-Handshake-Fehler vor Packet-Engine-Neustart
DTLS_FAIL_RE='ClientVersion DTLSv1\.0.*Handshake failure-Internal Error'
PPE_CRASH_RE='exit with orphan rings|NOT restarting NSPPE'

# --- Login-Endpunkte im HTTP-Access-Log (fuer Quell-IP-Korrelation)
# +2026-09-27 CTX697096 (betroffene Endpunkte) und +2026-10-03 CTX697174 (SAML-Endpunkte)
LOGIN_PATH_RE='/nf/auth/doAuthentication\.do|/cgi/login|/p/u/doLogon\.do|/logon/LogonPoint/Authentication/GetUserName|/nitro/v1/config/login|/cgi/samlauth|/saml/login'

# --- Mitigation: Policies, deren Regel eines dieser Muster enthaelt, gelten als Mitigation.
# Nur Muster, die jede Log-Poisoning- oder SAML-Mitigation enthaelt, weil sie aus dem Angriff selbst stammen.
# Namen und Ausdruecke der eigenen Policies gehoeren in ns_quickcheck.whitelist (mitigation:...).
# +2026-10-05 Bulletins und Community-Mitigationen (Trigger-Texte, IFS, SAML-Endpunkte, Logon-Endpunkt)
# +2026-10-08 Betreiberspezifische Muster (Policy-Expression-Namen, ADFS-Pfade) entfernt, siehe Changelog 2026-10-08e
MITIGATION_RULE_RE='pitboss|unexpectedly|heartbeats|IFS|samlauth|saml/login|doAuthentication'

# --- Kompromittierungs-Schnellcheck
# Bekannte Payload-/Webshell-Pfade (Existenz = rot). Pfade relativ zu /.
# +2026-09-29 Mandiant/GTIG (WHIPSHOT/SLAPSHOT: .ctxs.receiver, .slap, .nsmon, .ux); .host, x.sh, v seit 2026-10-19 inaktiv bis zur Fundstellenpruefung
# +2026-10-14 Sygnia Advisory 01.10. (Appendix 2, investigation-derived): c88771.json unter ns_gui/vpn
# +2026-10-15b Recherche voll (CERT-EU Blog 28.09., LevelBlue SpiderLabs 02.10., watchTowr via PitScaler 07.10., SOCRadar 07.10., Community-Feldbericht): Post-Exploitation-Dateien unter LogonPoint, Polling-Agent, trojanisiertes Dropbear, C2 mit DNS-OOB, weitere Dropper-Namen
# +2026-10-16 Huntback.io (Fundstellenpruefung ausstehend, Werte inaktiv in Custom): ns_helper unter /var/vpn und /nsconfig, /tmp/.p; LevelBlue: ersetztes customsnmpd (Platypus)
# +2026-10-19 Entfernt auf Verlangen der Rechteinhaber (19.10.): alle Indikatoren, die ausschliesslich ueber Bloecke Dritter mit
# eingeschraenkter Erlaubnis in einem Community-Checker vorlagen (128 Adressen inkl. Scanner-Liste, 18 Hashes). Was aus Unit 42, CISA 261399 r1 oder eigenen Primaerquellen belegt ist, bleibt mit dieser Herkunft.
# +2026-10-16b cisagov/SIGMA_Rules Regel 261399 r1 (CISA Code and Media Analysis, modified 2026-10-07; Datei am 13.10. umbenannt, alte raw-URL 404): Behoerdenquelle, 209 Keywords gegen Regelstand geprueft; 56 Adressen und 22 Domains bereits enthalten; neu: 4 Hashes, 7 Pfade, Dropper nsgtrust.deb
# Web-Verzeichnisse (neue Dateien seit Boot = pruefen; PHP ausserhalb admin_ui = rot)
# +2026-10-06 ceterion: Verzeichnisse, in denen Webshells dieser Kampagne lagen
WEB_DIRS="var/netscaler/logon var/vpn var/netscaler/gui netscaler/ns_gui netscaler/portal"
# Erlaubte Root-Crontab-Zeilen (Regex); alles andere wird gemeldet
# +2026-10-06 ceterion: eigene Scripts. +2026-10-08: ns_snapshot_V[0-9]+ statt V1, nach Umstellung auf V5
# +2026-10-09 Repo liefert zusaetzlich unversionierte Kopien (ns_snapshot.sh, ns_quickcheck.sh); Versionssuffix optional
ALLOWED_CRON_RE='ns_snapshot_V[0-9]+\.sh|ns_quickcheck_V[0-9]+\.sh|ctx697096_check\.sh|^#|^[[:space:]]*$|ns_snapshot\.sh|ns_quickcheck\.sh'
# Listener-Prozesse, die auf einem NetScaler nicht lauschen sollten
# +2026-09-29 Mandiant/GTIG, CISA 261399 r1: perl/python-Listener der Implants; socat/php vorsorglich
SUSPECT_LISTENER_RE='^(perl|python[0-9.]*|sh|bash|nc|ncat|socat|php)[[:space:]]|^walk[[:space:]]'
# Verdaechtige Prozesse in der Prozessliste (ab Script-V12; ab V14 mit dreistufiger Parent-Bewertung).
# +2026-10-14 CISA SIGMA 29.09. (S7): ns_monuploadd_err.pl mit -WR ausserhalb des Stock-Mechanismus.
# +2026-10-14b Lab 14.1-73.46: das Script laeuft NICHT per Cron, sondern wird vom Daemon /netscaler/monuploadd (Pitboss-Watch,
#   Start mit -P) bei Bedarf aufgerufen; Optionen -HDDCF, -WR, -MA, -MAWO, -NSAPPS_CORES, genau eine. Legitimer Parent ist
#   monuploadd (Info), cron ist nicht der Stock-Mechanismus (gelb), alles andere rot. Kindprozesse des Scripts, die Shell oder
#   Downloader sind, sind die Ausfuehrung der Injection (rot).
SUSPECT_PROC_RE='ns_monuploadd_err\.pl[[:space:]]+-WR'
SUSPECT_PROC_PARENT_OK_RE='monuploadd'
SUSPECT_PROC_CHILD_RE='(^|/)(sh|bash|csh|perl|python[0-9.]*|curl|wget|fetch|nc)([[:space:]]|$)'
# Request-Pfade, die nur im Angriffskontext interessant sind (ab Script-V12: Zaehlung je Quell-IP in httpaccess; gelb,
# rot bei Quell-IP mit Injection-Zeile). Nicht in LOGIN_PATH_RE, weil es legitime Downloads sind.
# +2026-10-14 CISA SIGMA 29.09. (S6): Linux-Client-Pakete als Dropper-Transport
DROPPER_PATH_RE='/vpn/scripts/linux/nsgclient18(_32)?\.deb|/vpn/scripts/linux/(nsgser18|nsgsupport|nsgpackage64|nsgbuild|nsg64)\.deb|/vpn/scripts/linux/nsginstaller[^ "]*\.deb|/vpn/scripts/linux/[^ "]*\.php|/vpn/scripts/linux/nsgtrust\.deb'

# +2026-10-21 Webserver-Fehlerlog (httperror.log, httperror-vpn.log). Zwei Muster:
#   HTTPERR_EXEC_RE: der Interpreter hat etwas ausgefuehrt oder versucht (PHP-Fehler, Script nicht gefunden); Rot ausserhalb admin_ui.
#   HTTPERR_PROBE_RE: "File does not exist" fuer Webshell-Namen, PHP-Varianten und Scanner-Pfade; Gelb "Sondierung", die Dateien
#   existieren nicht (sonst meldet Block 5). Dateinamen aus PAYLOAD_PATHS nimmt das Script zusaetzlich. Alle anderen
#   "File does not exist" (CSS, Icons, JS eines Themes) sind kein Befund. Quellen: Apache-Standardmeldungen; Webshell-Namen
#   aus CTX697096, Unit 42 30.09., LevelBlue 02.10., CISA 261399 r1. Lab-Lauf 21.10.: Sondierung von .ctxs.receiver in allen Theme-Ordnern.
HTTPERR_EXEC_RE='PHP (Parse|Fatal|Warning|Notice) error|PHP Warning|Premature end of script headers|script not found or unable to stat'
HTTPERR_PROBE_RE='File does not exist: .*(/\.ctxs[^/ ]*|/\.local_journal|/\.slap[^/ ]*|/\.nsmon|/\.ux|\.[Pp][Hh][Pp]$|/vpns/cfg/|/vpns/.*\.php|/\.\./|/\.\.$)'
# +2026-10-21 SSH- und Konsolenanmeldungen (auth.log): Standardmeldungen von sshd und login (OpenSSH, FreeBSD PAM).
AUTH_LOGIN_RE='sshd\[[0-9]+\]: Accepted (password|publickey|keyboard-interactive/pam) for [^ ]+ from [0-9.]+|login: login on .* as [^ ]+'
AUTH_FAIL_RE='sshd\[[0-9]+\]: (Failed password for (invalid user )?[^ ]+ from [0-9.]+|Invalid user [^ ]+ from [0-9.]+|error: maximum authentication attempts exceeded)'
# +2026-10-21 Management-Ebene (httpaccess.log der NSIP): NITRO- und GUI-Pfade; Zugriffe von Adressen ausserhalb RFC 1918 und ausserhalb
#   MGMT_NET_RE (Betreiber-Config) sind einzuordnen. Pfade aus der NetScaler-Dokumentation (NITRO v1, GUI /menu/).
MGMT_PATH_RE='"(GET|POST|PUT|DELETE) /(nitro/v1|menu|admin_ui|rapi)/'

# +2026-10-21 Gateway-Anmeldefehler (ns.log, AAA): Credential Stuffing und Password Spraying; Schwellen AAA_FAIL_IP und AAA_FAIL_USERS
#   in ns_quickcheck.conf. Quelle: NetScaler-Syslog-Format AAA LOGIN_FAILED / authenticate user failed (Citrix-Dokumentation Audit-Logging).
AAA_FAIL_RE='AAA (LOGIN_FAILED|Message [0-9]+ 0 :  "authenticate user: failed)|AAA LOGIN_FAILED|SSLVPN LOGIN_FAILED'
# +2026-10-21 Erfolgreiche Gateway-Anmeldungen (ns.log, AAA): fuer die Paarung "Fehlserie, dann Erfolg" je Adresse und Konto.
AAA_OK_RE='AAA (LOGIN|Message [0-9]+ 0 :  "authenticate user: succeeded)|SSLVPN LOGIN [0-9]+ 0 :  Context|AAA LOGIN [0-9]+ 0 :  Context'

# +2026-10-23 PHP2Shell (CTX697263, CVE-2026-109618/109619): Hypothese, keine veroeffentlichte Signatur. Die CVEs nutzen Out-of-Memory-
#   und Fatal-Error-Pfade im PHP des Management-Portals; Apache meldet solche Zustaende im Fehlerlog. Das Script wertet diese Muster
#   ueber alle httperror-Zeilen aus, auch im admin_ui (dort laeuft PHP legitim), mit Schwelle PHP_ANOMALY_MIN aus der Config.
#   Quellen: Unit 42 21.10. (Mechanismus longjmp/OOM), Zscaler 21.10., Red Hat CVE-Eintrag; Muster sind Standard-PHP-Meldungen.
HTTPERR_PHP_ANOMALY_RE='Allowed memory size of [0-9]+ bytes exhausted|PHP Fatal error: +Out of memory|zend_mm_heap corrupted|Maximum execution time of [0-9]+ seconds exceeded'
# +2026-10-23 Mitigation nach CTX697263: ACLs, die Port 80 und 443 der Management-Adressen sperren oder auf vertrauenswuerdige Quellen begrenzen.
#   Das Script prueft je Management-Adresse (NSIP, SNIP mit -mgmtAccess), ob eine DENY-ACL mit dieser destIP und Port 80 oder 443 existiert.
MGMT_ACL_RE='^add ns acl [^ ]+ DENY .*-destIP (= )?NSIP_PLACEHOLDER .*-destPort (= )?(80|443)'
# Stock-Hashes von Systemdateien je Build (ab Script-V12): '<pfad relativ zu />::<sha256>::<build>' je Zeile, leer = nur Ausgabe
# des Ist-Hashes im Report ohne Bewertung. Erster Kandidat: netscaler/ns_monuploadd_err.pl (Mechanismus von CVE-2026-88771).
# +2026-10-14b Lab 14.1-73.46, Erstinstallation 2026-10-14, kein SAML, keine Spuren. FIPS-Builds: Wert nicht bekannt (dann nur Info).
STOCK_FILE_HASHES='netscaler/ns_monuploadd_err.pl::02b24a9923a6cee1fbee48137b7f81b7e0f5169246728b7368fc3a066c43a708::14.1-73.46'
STOCK_HASH_FILES='netscaler/ns_monuploadd_err.pl'
# Bekannte Payload- und Webshell-Hashes (SHA-256) fuer die Pruefung neuer Dateien in Web- und Temp-Pfaden (ab Script-V16).
# Werte und Herkunft je Hash im IOC-Abschnitt (Unit 42 30.09., CISA 261399 r1 07.10.).
# Bekannte Stock-Listener dieser Interpreter (Format "COMMAND USER ADRESSE:PORT", wie im Report). Treffer = kein Befund.
# Unbekannte Interpreter-Listener: auf Loopback Gelb, auf anderen Adressen Rot.
# +2026-10-08 Lab 14.1-73.41 Stock: php-fpm (Admin-UI) auf 127.0.0.1:9999, Management-Dienst python3 auf 127.0.0.1:29000
KNOWN_LISTENER_RE='^php root 127\.0\.0\.1:9999$|^python[0-9.]* root 127\.0\.0\.1:29000$'
# Verzeichniswurzeln, aus denen der NetScaler-Apache regulaer Webinhalte liefert. Ein Alias in Gateway-Pfade
# (/vpns, /logon, /epa) mit Ziel ausserhalb dieser Wurzeln ist Rot (Technik: Alias auf beschreibbares Verzeichnis).
# +2026-10-08 Lab 14.1-73.41 Stock: elf Aliase auf /var/ns_gui/support und /netscaler/portal/...
STOCK_ALIAS_ROOTS='/netscaler/ /var/ns_gui/ /var/netscaler/ /var/vpn/ /var/python/ /var/nsinstall/'

# --- Bekannte Accounts und Infrastruktur (v2) ---------------------------------
# Der Service-User des Verfahrens kommt aus CLI_USER (ns_snapshot.conf) und ist automatisch erlaubt.
# Hier nur betreiberuebergreifend bekannte Konten, in der Regel keine. Betreiberkonten: ns_quickcheck.whitelist (user:...).
# +2026-10-08 leer; der Lab-Service-User wurde entfernt, Regeldatei ist betreiberneutral
ALLOWED_SYSTEM_USERS=''
# Bekannte Angreifer-Adressen fuer den Abgleich ausgehender Verbindungen (Regex, Punkte escaped).
# Bewusst kurz: die vollstaendige Liste pflegt der Collector. Adressen und Domains duerfen aus Sekundaerquellen kommen
# (markiert), weil sie nur auf ausgehende Verbindungen und Download-Hosts wirken; Logmuster, Pfade, Hashes und
# Build-Nummern nur aus Primaerquellen.
# +2026-09-29 Mandiant/GTIG, +2026-09-30 Unit 42, +2026-10-07 CISA 261399 r1: Scan- und C2-Adressen der Kampagne (je Wert im IOC-Abschnitt)
# +2026-10-15 Unit 42 Threat Brief "NetScaler Zero Days CVE-2026-88771 and CVE-2026-88772" (publiziert 30.09., Stand 08.10.): IoC-Liste 9 Adressen, 9 weitere nur im Fliesstext (geringere Gewichtung), Dropper-Transportnamen
# +2026-10-15e CTX697096 Wortlaut gegengelesen (Direktabruf 15.10.): 88774 Bedingung auf Citrix-Pruefmuster (HTTP/SSL-vServer) korrigiert, 88776 und 88777 auf Bulletin-Regex
# Download-/C2-Domains (Regex) fuer denselben Abgleich
# +2026-09-29 Mandiant/GTIG (pylrk.cc), +2026-10-07 CISA 261399 r1 (gsocket, webhook.site, dnshook.site)


