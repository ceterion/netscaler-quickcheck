# ns_quickcheck.msg.de - Nachrichtenkatalog fuer netscaler-quickcheck 17.43
# Format: KEY<TAB>Text; Platzhalter %1..%9 in Reihenfolge der Werte im Script-Aufruf
# --- TAG: Kennungen
TAG_OK	[OK]
TAG_INFO	[INFO]
TAG_WARN	[WARN]
TAG_YELLOW	[GELB]
TAG_RED	[ROT]
TAG_ORANGE	[ORANGE]
TAG_TRUST	[TRUST]
TAG_ACTION	ACTION
TAG_RESULT	RESULT
# --- HDR: Kopf, Blockueberschriften, anon-Hinweise
HDR_CFG_FROM_SNAPSHOT_CONF	cli_user aus ns_snapshot.conf
HDR_CRLF_FIXED	Windows-Zeilenenden (CR) beim Einlesen entfernt: %1; Dateien bitte mit LF speichern (tr -d '\r')
HDR_CFG_FROM_QUICKCHECK_CONF	cli_user aus ns_quickcheck.conf
HDR_CVE_CONFLICT_COND_FRAG	%1 %2 (Fix gleich, Bedingung Regeldatei %3, custom %4);
HDR_CVE_CONFLICT_FIX_FRAG	%1 %2 (Regeldatei Fix %3, custom Fix %4);
HDR_ANON_COMMENT_REMOVED	# (Kommentar entfernt)
HDR_CLI_REASON_NO_CLI	per --no-cli abgeschaltet
HDR_CLI_REASON_NO_USER	CLI_USER nicht gesetzt
HDR_CLI_REASON_NO_NSCLI	/netscaler/nscli fehlt
HDR_CLI_REASON_NO_SECRET	Secret-Datei fehlt
HDR_CLI_REASON_SECRET_PERMS	Secret-Datei nicht root:600
HDR_CLI_REASON_SECRET_EMPTY	Secret-Datei leer
HDR_RUN_LINE	ns_quickcheck %1  host=%2  modus=%3  fenster=%4h  regeln=%5  cli=%6%7  %8
HDR_CUSTOM_LOADED	Custom-Datei des Betreibers geladen: %1 aktive Indikator-Zeile(n), %2 CVE-Zeile(n) (%3)
HDR_CUSTOM_NO_VERSION	ohne Version
HDR_CVE_CONFLICT	Regeldatei und Custom-Datei bewerten %1 CVE unterschiedlich; beide Zeilen werden geprueft, das strengere Ergebnis zaehlt: %2
HDR_RULES_OLDER	Regeldatei %1 ist aelter als der Mindeststand dieses Scripts (%2); Pruefungen, deren Regeln fehlen, entfallen mit Hinweis
HDR_TRUSTED_EXPIRED_FRAG	, %1 abgelaufen und uebergangen
HDR_TRUSTED_LIST	Vertrauensliste: %1 Eintrag/Eintraege (ns_quickcheck.trusted_ips)%2; vertraute Adressen erscheinen als [TRUST], Wirkungs-Befunde bleiben Rot
HDR_TRUSTED_BAD_LINES	Vertrauensliste: Zeile(n) %1 uebergangen (keine IPv4-Adresse; Format: adresse ; bis ; Bemerkung)
HDR_TRUSTED_AND_BLOCKED	%1 steht in trusted_ips und in der Sperrliste; die Sperrliste gilt
HDR_BLOCKED_LIST	Sperrliste: %1 Eintrag/Eintraege (ns_quickcheck.blocked_ips und ACLs der Appliance); Befunde zu gesperrten Adressen vor dem Sperrdatum werden ORANGE (abgedeckt)%2
HDR_BLOCKED_NODATE_FRAG	; %1 ohne Datum: nur markiert, fuer ORANGE das Sperrdatum (YYYY-MM-DD) als zweites Feld eintragen
HDR_BLOCKED_BAD_LINES	Sperrliste: Zeile(n) %1 uebergangen (keine IPv4-Adresse; Format: adresse ; seit ; Bemerkung)
HDR_IOC_INACTIVE	Regeldatei Format 2: %1 Indikator-Zeile(n) inaktiv (Fundstelle ausstehend oder zur Entfernung markiert)
HDR_OFFLINE_SOURCE	Quelle: %1
HDR_CLI_OFF	CLI-Ebene aus: %1
HDR_CLI_REASON_NONE	kein Weg
HDR_WHITELIST_LOADED	Whitelist: %1 (%2 Regeln)
HDR_WL_WEBFILE_UNANCHORED	Whitelist: webfile-Regel(n), die weder mit / (Verzeichnis) noch mit $ (Datei) enden, treffen mehr als gewollt: %1(README 15)
HDR_WL_DIR_RULES	Whitelist: %1 Verzeichnisregel(n) ohne Hash; sie geben alles darunter frei, auch neue Dateien (nie Code). Empfohlen: Pins je Datei, --pin-all <ordner> (WORKFLOW, Whitelist)
HDR_WL_CODE_NO_PIN	Whitelist: Dateiregel(n) auf Code ohne Hash-Pin sind wirkungslos, Code braucht @sha256=<hash> (--pin <pfad> erzeugt die Zeilen): %1
HDR_WHITELIST_MISSING	Whitelist: nicht vorhanden (%1); alle Befunde ungefiltert
HDR_BLOCK1	1 Build
HDR_BLOCK2	2 Exposure
HDR_BLOCK3	3 Mitigation
HDR_BLOCK4	4 Angriffsspuren (letzte %1h)
HDR_BLOCK5	5 Kompromittierungs-Schnellcheck
HDR_BLOCK6	6 Verdict
HDR_ANON_REPORT_NOTE	# anonymisiert nach Zuordnungstabelle (%1 Eintraege%2); Angreifer-Werte, Hashes, Pfade und Regelstaende unveraendert. Stichprobe vor Weitergabe.
HDR_ANON_SKIPPED_FRAG	; uebergangen, weil zu kurz oder Reportwort: %1
# --- BUILD: Block 1 Build
BUILD_FROM_NSCONF	Build aus ns.conf-Header (kern.bootfile nicht verfuegbar)
BUILD_FALLBACK_TEXT_RCE	Pre-Auth RCE, aktiv ausgenutzt
BUILD_FALLBACK_TEXT_SAML	SAML DoS, CISA KEV
BUILD_UNKNOWN_YEL	Build nicht ermittelbar - 'show ns version' pruefen
BUILD_EOL_RED	Release %1 ist End-of-Life, kein Fix verfuegbar (laufend: %2)
BUILD_TRAIN_UNKNOWN_YEL	Train %1 nicht in der Regeldatei (%2) - manuell gegen Bulletin pruefen (laufend: %3)
BUILD_CVE_PENDING_FRAG	(Fix-Build noch nicht veroeffentlicht, Stand %1; bis dahin Mitigation, Block 2 und 3)
BUILD_CVE_FIX_INVALID_FRAG	%1 %2: Fix-Build '%3' ungueltig
BUILD_CVE_COND_FRAG	 (Bedingung: %1 konfiguriert)
BUILD_VULN_NOFIX_RED	Build %1 ist VERWUNDBAR gegen %2 (%3), kein Fix-Build veroeffentlicht: %4
BUILD_VULN_RED	Build %1 ist VERWUNDBAR gegen %2 (%3), Fix ab %4: %5
BUILD_TARGET	Ziel-Build fuer diesen Train: %1-%2
BUILD_ALL_FIXED_OK	Build %1 enthaelt alle %2 Fix(es) fuer %3%4%5
BUILD_FIX_NA_FRAG	, %1 CVE(s) ohne konfigurierte Bedingung
BUILD_FIX_RULES_FRAG	 der Regeldatei
BUILD_FIX_SPLIT_FRAG	 (%1 Regeldatei, %2 custom)
BUILD_RULES_ROW_YEL	Regeldatei: %1
BUILD_VULN_JSON_PREFIX	Verwundbar:
BUILD_CONF_NOT_SAVED_YEL	ns.conf wurde auf %1 gespeichert, laufend ist %2 - 'save ns config' nach dem Upgrade fehlt
BUILD_WARN_YEL	Build %1: %2
BUILD_STAGED_NOT_BOOTED_YEL	%1 ist installiert (%2), aber nicht gebootet - Reboot ausstehend?
BUILD_LAST_BOOT	Letzter Boot: %1 (%2 Tage)
# --- EXPO: Block 2 Exposure
EXPO_SAML_CVE_OPEN	SAML konfiguriert (SP=%1 IdP=%2) - SAML-abhaengige CVE offen, siehe Block 1
EXPO_SAML	SAML konfiguriert (SP=%1 IdP=%2)
EXPO_NO_SAML_OK	Kein SAML SP/IdP - SAML-abhaengige CVEs nicht relevant
EXPO_DTLS	DTLS an %1 Gateway-vServer aktiv (CVE-2026-88772-Voraussetzung; auf gefixtem Build mitigiert)
EXPO_NO_DTLS_OK	Kein DTLS an Gateway-vServern
EXPO_ISN_STEP_MISSING_YEL	Konfigurationsschritt fehlt: set ns tcpParam -%1 (%2, %3) - bleibt auch nach Upgrade offen
EXPO_ISN_ACTIVE_OK	Enhanced ISN Generation aktiv
EXPO_PARTITIONS	%1 Admin-Partition(en) - TCP-Parameter und ISN dort separat pruefen
EXPO_MGMT_ON_SNIP_YEL	Management-Zugriff auf SNIP aktiv: %1 - NITRO/GUI erreichbar; CVE-2026-88771 wird auch ueber fehlgeschlagene NITRO-Logins gestaged
EXPO_MGMT_NSIP_UNKNOWN	Management-Portal: NSIP nicht aus der ns.conf bestimmbar, ACL-Mitigation (CTX697263) nicht geprueft
EXPO_MGMT_NO_ACL_VULN_YEL	Management-Portal (PHP, CTX697263) auf verwundbarem Build ohne ACL-Schutz: %1- bis zum Update Port 80/443 dieser Adressen per ACL auf Admin-Netze begrenzen (Citrix-Empfehlung)
EXPO_MGMT_NO_ACL_FIXED	Management-Portal ohne DENY-ACL auf Port 80/443: %1(Build gegen CTX697263 gefixt; ACL bleibt empfehlenswert, wenn das Portal nicht nur aus Admin-Netzen erreichbar ist)
EXPO_MGMT_ACL_OK	Management-Portal: DENY-ACLs auf Port 80/443 fuer %1 vorhanden (Citrix-Mitigation CTX697263)
EXPO_MGMT_ACL_RULE_MISSING	Management-Portal-ACLs nicht geprueft: Regel MGMT_ACL_RE fehlt in der Regeldatei (%1; benoetigt %2 oder neuer)
# --- MITIG: Block 3 Mitigation
MITIG_NONE_VULN_YEL	Keine Responder-/Traffic-Policy mit Log-Poisoning- oder SAML-Mustern - auf ungefixtem Build fehlt jede Mitigation
MITIG_NONE	Keine Mitigation-Policy gefunden (auf gefixtem Build ohne Spuren nicht erforderlich)
MITIG_POLICY_UNBOUND_YEL	%1-Policy %2 existiert, ist aber nirgends gebunden
MITIG_RESPONDER_OFF_YEL	%1-Policy %2 gebunden (%3), aber Responder-Feature ist AUS - Policy wirkungslos
MITIG_NO_AAA_REQUEST_YEL	%1-Policy %2 gebunden (%3), aber ohne -type AAA_REQUEST - sieht keinen Logon-Traffic
MITIG_RESPONDER_BOUND_OK	%1-Policy %2 gebunden (%3 vServer, %4 x AAA_REQUEST%5)
MITIG_POLICY_BOUND_OK	%1-Policy %2 gebunden (%3 vServer)
MITIG_HITS	  Hits %1: %2 (seit letztem Counter-Reset)
MITIG_HITS_DELTA	  Hits %1: %2 (+%3 seit %4)
MITIG_DENYLIST_OK	Global Deny List AAA_REQUEST vorhanden (Console-Signaturen)
MITIG_DENYLIST_NONE	Keine Global Deny List AAA_REQUEST (nicht konfiguriert)
MITIG_DENYLIST_UNKNOWN	Global Deny List: keine Aussage moeglich
# --- TRACE: Block 4 Angriffsspuren (ohne Gateway-AAA)
TRACE_IOC_SOURCE_FRAG	 - Quelle: %1 %2
TRACE_DETAIL_MORE	... und %1 weitere (DETAIL_MAX=%2)
TRACE_BLOCKED_TAG_FRAG	 (Sperre ab %1%2)
